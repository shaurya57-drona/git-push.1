rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint for User Profiles
    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
             data.language in ['en', 'hi'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation Blueprint for User Favorites
    function isValidFavorite(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.buildingId is string && data.buildingId.size() <= 64 && data.buildingId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.conicType in ['circle', 'ellipse', 'parabola', 'hyperbola'] &&
             data.createdAt is timestamp;
    }

    // Validation Blueprint for Quiz Results
    function isValidQuizResult(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.score is number && data.score >= 0 && data.score <= 100 &&
             data.total is number && data.total > 0 && data.total <= 100 &&
             data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
             data.completedAt is timestamp;
    }

    // Validation Blueprint for Judge Feedback
    function isValidFeedback(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
             (!('buildingId' in data) || (data.buildingId is string && data.buildingId.size() <= 64)) &&
             data.createdAt is timestamp;
    }

    // Connection check endpoint
    match /test/{testId} {
      allow get: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == userId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'language', 'updatedAt', 'email']);
      allow delete: if isOwner(userId);

      // User Bookmarks / Favorites Subcollection
      match /favorites/{favoriteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(favoriteId) &&
                         isValidFavorite(incoming()) &&
                         incoming().userId == userId &&
                         incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // Quiz Results / Leaderboard (Public read, verified write)
    match /quizResults/{resultId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(resultId) &&
                       isValidQuizResult(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().completedAt == request.time;
      allow update, delete: if false;
    }

    // Judge / Visitor Feedback
    match /feedback/{feedbackId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(feedbackId) &&
                       isValidFeedback(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(feedbackId) &&
                       resource.data.userId == request.auth.uid &&
                       isValidFeedback(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']);
      allow delete: if isSignedIn() && isValidId(feedbackId) &&
                       resource.data.userId == request.auth.uid;
    }
  }
}
